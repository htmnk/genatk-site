# Add this only after a domain is connected. It enables live-page checks locally.
SITE_URL=

# Optional. Set this to the public Buttondown newsletter username to render the
# consent-based waitlist form at build time. It is not a secret.
PUBLIC_BUTTONDOWN_USERNAME=

# Not used by the scaffold yet. The future drafting job will read the value only
# from a local .env file or a GitHub Actions secret, never from version control.
OPENAI_API_KEY=
