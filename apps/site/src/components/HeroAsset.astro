---
const { id = 'hero-asset' } = Astro.props;
---

<div class="asset-shell" id={id} data-hero-asset>
  <div class="asset-bar"><span>building.house</span><strong>seed <output>12</output></strong></div>
  <div class="asset-canvas" aria-label="Interactive procedural building preview. Drag to rotate it."></div>
  <label class="asset-control"><input aria-label="Building variation seed" type="range" min="1" max="48" value="12" /><span><b>slide for a new variation</b><b>48 of ∞</b></span></label>
</div>

<script>
  import * as THREE from 'three';

  const BODY = [0xff6b35, 0xff8c5a, 0xe85d3d, 0xffa34d];
  const ROOF = [0x2ec4a6, 0x1fa98d, 0x36d6b7, 0x178f76];
  const TRIM = [0xffc53d, 0xffd46b];
  const EDGE = 0xfbf4e8;
  const rng = (seed: number) => () => {
    seed |= 0; seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };

  function mount(root: HTMLElement) {
    const canvas = root.querySelector<HTMLElement>('.asset-canvas')!;
    const slider = root.querySelector<HTMLInputElement>('input')!;
    const output = root.querySelector<HTMLOutputElement>('output')!;
    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(34, 1, .1, 100);
    camera.position.set(6.2, 4.35, 7.2); camera.lookAt(0, 1.1, 0);
    const renderer = new THREE.WebGLRenderer({ antialias: true, alpha: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.domElement.style.cssText = 'width:100%;height:100%;display:block;touch-action:none;cursor:grab';
    canvas.append(renderer.domElement);
    scene.add(new THREE.AmbientLight(0xfff2e0, 1.15));
    const sun = new THREE.DirectionalLight(0xffffff, 1.75); sun.position.set(4, 7, 5); scene.add(sun);
    const rim = new THREE.DirectionalLight(0x2ec4a6, .55); rim.position.set(-5, 3, -4); scene.add(rim);
    const group = new THREE.Group(); scene.add(group);
    const disposables: Array<THREE.BufferGeometry | THREE.Material> = [];
    const material = (color: number, opacity = .62) => {
      const result = new THREE.MeshStandardMaterial({ color, transparent: true, opacity, roughness: .61, depthWrite: false }); disposables.push(result); return result;
    };
    const edges = () => {
      const result = new THREE.LineBasicMaterial({ color: EDGE, transparent: true, opacity: .8 }); disposables.push(result); return result;
    };
    const wire = (geometry: THREE.BufferGeometry) => { const result = new THREE.EdgesGeometry(geometry); disposables.push(result); return new THREE.LineSegments(result, edges()); };
    const clear = () => { while (group.children.length) group.remove(group.children[0]); disposables.splice(0).forEach((item) => item.dispose()); };
    const box = (w: number, h: number, d: number, x: number, y: number, z: number, color: number, opacity = .62) => {
      const geo = new THREE.BoxGeometry(w, h, d); disposables.push(geo); const mesh = new THREE.Mesh(geo, material(color, opacity)); mesh.position.set(x, y, z); group.add(mesh);
      const outline = wire(geo); outline.position.copy(mesh.position); group.add(outline);
    };
    const roof = (w: number, d: number, h: number, y: number, color: number, x = 0, z = 0) => {
      const shape = new THREE.Shape(); shape.moveTo(-d / 2, 0); shape.lineTo(d / 2, 0); shape.lineTo(0, h); shape.closePath();
      const geo = new THREE.ExtrudeGeometry(shape, { depth: w, bevelEnabled: false }); geo.rotateY(Math.PI / 2); geo.translate(-w / 2, 0, 0); disposables.push(geo);
      const mesh = new THREE.Mesh(geo, material(color)); mesh.position.set(x, y, z); group.add(mesh);
      const outline = wire(geo); outline.position.copy(mesh.position); group.add(outline);
    };
    const build = (seed: number) => {
      clear(); const r = rng(seed * 7919 + 13); const body = BODY[(r() * BODY.length) | 0]; const roofColor = ROOF[(r() * ROOF.length) | 0]; const trim = TRIM[(r() * TRIM.length) | 0];
      const w = 2.25 + r() * 1.35, d = 1.7 + r() * 1.12, h = 1.25 + r() * 1.05;
      const ground = new THREE.CylinderGeometry(3.4, 3.4, .12, 48); disposables.push(ground); const disc = new THREE.Mesh(ground, material(0x2b231b, .62)); disc.position.y = -.06; group.add(disc);
      const discEdge = wire(ground); discEdge.position.y = -.06; group.add(discEdge);
      box(w, h, d, 0, h / 2, 0, body);
      const style = r();
      if (style > .63) { const h2 = .72 + r() * .55; box(w * .72, h2, d * .72, (r() - .5) * .3, h + h2 / 2, 0, body); roof(w * .72 + .3, d * .72 + .3, .62 + r() * .42, h + h2, roofColor); }
      else if (style > .26) roof(w + .32, d + .32, .72 + r() * .6, h, roofColor);
      else { const geo = new THREE.ConeGeometry(Math.max(w, d) * .78, .95 + r() * .6, 4); disposables.push(geo); const mesh = new THREE.Mesh(geo, material(roofColor)); mesh.position.set(0, h + .5, 0); mesh.rotation.y = Math.PI / 4; group.add(mesh); const outline = wire(geo); outline.position.copy(mesh.position); outline.rotation.y = mesh.rotation.y; group.add(outline); }
      if (r() > .48) { const ww = .95 + r() * .65, wh = h * .61, wd = d * .7, wx = (w / 2 + ww / 2) * (r() > .5 ? 1 : -1); box(ww, wh, wd, wx, wh / 2, .1, body); roof(ww + .24, wd + .24, .46 + r() * .27, wh, roofColor, wx, .1); }
      if (r() > .42) box(.25, .82 + r() * .45, .25, (r() - .5) * w * .6, h + .45, (r() - .5) * d * .4, trim, .85);
      box(.43, .72, .06, (r() - .5) * w * .4, .36, d / 2 + .03, trim, .92);
      const windows = 1 + ((r() * 3) | 0); for (let i = 0; i < windows; i++) box(.31, .31, .05, -w / 2 + .5 + i * ((w - 1) / Math.max(windows - 1, 1)), h * .62, d / 2 + .03, 0xfbf4e8, .92);
      const trees = (r() * 3) | 0; for (let i = 0; i < trees; i++) { const a = r() * Math.PI * 2, rad = 2.2 + r() * .8, tx = Math.cos(a) * rad, tz = Math.sin(a) * rad; box(.14, .5, .14, tx, .25, tz, 0x8a5a34, .83); const geo = new THREE.IcosahedronGeometry(.35 + r() * .25, 0); disposables.push(geo); const crown = new THREE.Mesh(geo, material(ROOF[(r() * ROOF.length) | 0], .66)); crown.position.set(tx, .75 + r() * .3, tz); group.add(crown); const outline = wire(geo); outline.position.copy(crown.position); group.add(outline); }
    };
    let dragging = false, previousX = 0, velocity = 0, morphProgress = 0, morphTimer = 0, resumeTimer = 0, autoPaused = false, disposed = false;
    const showVariation = (seed: number) => {
      slider.value = String(seed); output.value = String(seed); morphProgress = 1; group.rotation.y += .34;
      canvas.dataset.morphing = 'true'; window.clearTimeout(morphTimer);
      morphTimer = window.setTimeout(() => { delete canvas.dataset.morphing; }, 680); build(seed);
    };
    const pauseAutoAdvance = () => { window.clearTimeout(resumeTimer); autoPaused = true; };
    const resumeAutoAdvance = () => { window.clearTimeout(resumeTimer); resumeTimer = window.setTimeout(() => { autoPaused = false; }, 1100); };
    renderer.domElement.addEventListener('pointerdown', (event) => { dragging = true; previousX = event.clientX; renderer.domElement.setPointerCapture(event.pointerId); renderer.domElement.style.cursor = 'grabbing'; });
    renderer.domElement.addEventListener('pointermove', (event) => { if (!dragging) return; const delta = event.clientX - previousX; previousX = event.clientX; group.rotation.y += delta * .008; velocity = delta * .008; });
    renderer.domElement.addEventListener('pointerup', () => { dragging = false; renderer.domElement.style.cursor = 'grab'; });
    slider.addEventListener('pointerdown', pauseAutoAdvance);
    slider.addEventListener('pointerup', resumeAutoAdvance);
    slider.addEventListener('pointercancel', resumeAutoAdvance);
    slider.addEventListener('focus', pauseAutoAdvance);
    slider.addEventListener('blur', resumeAutoAdvance);
    slider.addEventListener('keydown', pauseAutoAdvance);
    slider.addEventListener('keyup', resumeAutoAdvance);
    slider.addEventListener('input', () => { pauseAutoAdvance(); showVariation(Number(slider.value)); });
    const autoAdvance = window.setInterval(() => {
      if (autoPaused || document.hidden) return;
      const next = Number(slider.value) >= Number(slider.max) ? Number(slider.min) : Number(slider.value) + 1;
      showVariation(next);
    }, 3000);
    const resize = () => { const rect = canvas.getBoundingClientRect(); renderer.setSize(Math.max(rect.width, 1), Math.max(rect.height, 1), false); camera.aspect = rect.width / Math.max(rect.height, 1); camera.updateProjectionMatrix(); };
    const observer = new ResizeObserver(resize); observer.observe(canvas); resize(); build(Number(slider.value));
    const loop = () => { if (disposed) return; requestAnimationFrame(loop); if (!dragging) { if (Math.abs(velocity) > .0004) { group.rotation.y += velocity; velocity *= .94; } else group.rotation.y += .0035; } if (morphProgress > .001) { const pulse = Math.sin(morphProgress * Math.PI); group.scale.setScalar(1 - pulse * .11); group.rotation.y += morphProgress * .095; morphProgress *= .86; } else group.scale.setScalar(1); renderer.render(scene, camera); }; loop();
    return () => { disposed = true; window.clearTimeout(morphTimer); window.clearTimeout(resumeTimer); window.clearInterval(autoAdvance); observer.disconnect(); clear(); renderer.dispose(); renderer.domElement.remove(); };
  }
  document.querySelectorAll<HTMLElement>('[data-hero-asset]').forEach((root) => mount(root));
</script>

<style>
  .asset-shell { border: 2px solid #3f362a; border-radius: 24px; background: linear-gradient(160deg, #2b231b, #241d16); box-shadow: 8px 8px 0 #120e0a; padding: 14px; }
  .asset-bar { display: flex; align-items: center; justify-content: space-between; gap: .8rem; padding: 4px 8px 10px; font: 700 .74rem/1.2 'JetBrains Mono', monospace; color: #b5a791; }
  .asset-bar strong { border: 1px solid rgba(159,242,223,.34); border-radius: 999px; background: transparent; color: #aee9dc; padding: .25rem .62rem; font-family: 'JetBrains Mono', monospace; font-size: .68rem; font-weight: 700; letter-spacing: .03em; }
  .asset-canvas { position: relative; height: clamp(280px, 34vw, 400px); overflow: hidden; border: 2px dashed #4a3f30; border-radius: 16px; background: radial-gradient(ellipse at 50% 80%, rgba(46,196,166,.16), transparent 60%); }
  .asset-canvas::after { position: absolute; z-index: 2; top: -30%; bottom: -30%; width: 34%; left: -45%; background: linear-gradient(90deg, transparent, rgba(255,244,232,.08), rgba(46,196,166,.56), rgba(255,197,61,.4), transparent); content: ''; opacity: 0; transform: skewX(-22deg); pointer-events: none; mix-blend-mode: screen; }
  .asset-canvas[data-morphing='true']::after { animation: variation-sweep .66s cubic-bezier(.18,.8,.22,1); }
  .asset-control { display: block; padding: 16px 10px 8px; } .asset-control input { width: 100%; height: 12px; margin: 0; appearance: none; border: 0; border-radius: 999px; outline: 0; background: linear-gradient(90deg, #ff6b35, #ffc53d, #2ec4a6); box-shadow: inset 0 2px 3px rgba(39,32,26,.25); cursor: grab; } .asset-control input::-webkit-slider-thumb { width: 28px; height: 28px; appearance: none; border: 3px solid #fff9ee; border-radius: 50%; background: #ffc53d; box-shadow: 0 4px 0 #d99c1a; } .asset-control input::-moz-range-thumb { width: 24px; height: 24px; border: 3px solid #fff9ee; border-radius: 50%; background: #ffc53d; box-shadow: 0 4px 0 #d99c1a; }
  .asset-control span { display: flex; justify-content: space-between; gap: 1rem; margin-top: 10px; color: #9c8e7d; font: 500 .64rem/1.3 'JetBrains Mono', monospace; } .asset-control b { font-weight: 500; }
  @keyframes variation-sweep { 0% { left: -45%; opacity: 0; } 18% { opacity: .92; } 72% { opacity: .62; } 100% { left: 115%; opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .asset-canvas[data-morphing='true']::after { animation: none; } }
</style>
