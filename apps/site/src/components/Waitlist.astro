---
const username = import.meta.env.PUBLIC_BUTTONDOWN_USERNAME?.trim();
const source = Astro.props.source ?? 'site';
const formAction = username ? `https://buttondown.com/api/emails/embed-subscribe/${encodeURIComponent(username)}` : undefined;
---
{formAction && <section class="waitlist" aria-labelledby="waitlist-title">
  <div>
    <p class="eyebrow">Early access</p>
    <h2 id="waitlist-title">Follow the build, not the hype.</h2>
    <p>Occasional notes on experiments, public labs, and the eventual toolkit. No launch-date promise and no spam.</p>
  </div>
  <form action={formAction} method="post">
    <label for={`waitlist-email-${source}`}>Email address</label>
    <div class="waitlist-row">
      <input id={`waitlist-email-${source}`} name="email" type="email" autocomplete="email" inputmode="email" placeholder="you@example.com" required />
      <input type="hidden" name="embed" value="1" />
      <input type="hidden" name="tag" value={`genatk-${source}`} />
      <button type="submit">Keep me posted</button>
    </div>
    <p class="fine-print">By subscribing, you agree to receive GenATK updates. You can unsubscribe at any time. See <a href="/privacy/">privacy</a>.</p>
  </form>
</section>}
