---
interface Props { title: string; description: string; canonical?: string; noindex?: boolean; }
const { title, description, canonical = Astro.url.pathname, noindex = false } = Astro.props;
const canonicalUrl = Astro.site ? new URL(canonical, Astro.site) : undefined;
---
<!doctype html><html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><meta name="description" content={description} /><link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin /><link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" /><link rel="icon" href="/genatk-icon.svg" type="image/svg+xml" /><link rel="manifest" href="/site.webmanifest" /><meta name="theme-color" content="#1c1712" />{noindex && <meta name="robots" content="noindex, nofollow" />}{canonicalUrl && <link rel="canonical" href={canonicalUrl} />}<title>{title}</title></head><body><a class="skip-link" href="#main-content">Skip to content</a><header class="site-header"><a class="brand" href="/" aria-label="GenATK home"><img src="/genatk-icon.svg" alt="" /><span>GenATK</span><small>IN DEV</small></a><nav aria-label="Primary"><a href="/#assets">Assets</a><a href="/labs/">Labs</a><a href="/learn/">Learn</a><a href="/research/">Research</a><a class="nav-cta" href="/#updates">Get updates</a></nav></header><main id="main-content"><slot /></main><footer class="site-footer"><div><img src="/genatk-icon.svg" alt="" /><strong>GenATK</strong><span>© 2026 · generative asset toolkit</span></div><span>made of math, not meshes</span><span><a href="/privacy/">Privacy</a></span></footer></body></html>
<style is:global>
  :root{color-scheme:dark;font-family:'Nunito',sans-serif;color:#fbf4e8;background:#1c1712;--ink:#1c1712;--ink-deep:#14100c;--panel:#2b231b;--line:#3a3229;--text:#fbf4e8;--muted:#cfc2ae;--orange:#ff6b35;--orange-soft:#ff8c5a;--yellow:#ffc53d;--mint:#2ec4a6;--mint-light:#9ff2df;--display:'Baloo 2',sans-serif;--mono:'JetBrains Mono',monospace}*{box-sizing:border-box}html{scroll-behavior:smooth;background:var(--ink)}body{min-width:20rem;margin:0;background:var(--ink);line-height:1.6;-webkit-font-smoothing:antialiased}a{color:var(--orange-soft);text-underline-offset:.17em}a:hover{color:var(--orange)}.skip-link{position:fixed;z-index:100;left:1rem;top:1rem;transform:translateY(-180%);border-radius:.5rem;background:var(--yellow);color:#1c1712;padding:.55rem .75rem;font-weight:800;text-decoration:none;transition:transform .15s ease}.skip-link:focus{transform:translateY(0)}
  .site-header{position:sticky;z-index:50;top:0;display:flex;min-height:78px;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:14px clamp(20px,5vw,64px);border-bottom:2px solid var(--line);background:rgba(28,23,18,.94);backdrop-filter:blur(16px)}.brand{display:inline-flex;align-items:center;gap:.72rem;color:var(--text);font:800 1.48rem/1 var(--display);text-decoration:none;letter-spacing:-.01em}.brand img{width:40px;height:40px;border-radius:10px}.brand small{border:1px solid rgba(255,197,61,.5);border-radius:999px;background:linear-gradient(180deg,rgba(255,197,61,.3),rgba(255,197,61,.1));color:#ffd46b;padding:.28rem .78rem;font-size:.67rem;letter-spacing:.06em}nav{display:flex;align-items:center;justify-content:flex-end;gap:clamp(.8rem,3vw,1.75rem);flex-wrap:wrap}nav a{color:var(--text);font-weight:700;font-size:.93rem;text-decoration:none}nav .nav-cta{border:1px solid rgba(46,196,166,.55);border-radius:999px;background:linear-gradient(180deg,rgba(46,196,166,.35),rgba(46,196,166,.14));box-shadow:0 8px 24px rgba(46,196,166,.22),inset 0 1px 0 rgba(255,255,255,.28);color:var(--mint-light);padding:.6rem 1.12rem;font-family:var(--display);font-weight:800}nav .nav-cta:hover{color:var(--text);background:linear-gradient(180deg,rgba(46,196,166,.5),rgba(46,196,166,.22))}
  .site-footer{display:flex;align-items:center;justify-content:space-between;gap:1rem;flex-wrap:wrap;padding:28px clamp(20px,5vw,64px);border-top:2px solid var(--line);color:#9c8e7d;font:500 .72rem/1.4 var(--mono)}.site-footer div{display:flex;align-items:center;gap:.62rem}.site-footer img{width:28px;height:28px;border-radius:7px}.site-footer strong{color:var(--text);font:800 1.06rem/1 var(--display)}.site-footer a{color:inherit}
  article{max-width:48rem;margin:auto;padding:3.5rem clamp(1.15rem,4vw,2.5rem)}h1,h2,h3{font-family:var(--display);line-height:1.03;letter-spacing:-.035em}h1{max-width:15ch;margin:.45rem 0 1.35rem;font-size:clamp(2.65rem,7vw,5.4rem)}h2{margin-top:3.5rem;font-size:clamp(1.9rem,4vw,2.7rem)}h3{font-size:1.35rem}.eyebrow{color:var(--orange-soft);font:700 .74rem/1.3 var(--mono);letter-spacing:.12em;text-transform:uppercase}.lede{max-width:42rem;color:var(--muted);font-size:clamp(1.1rem,2vw,1.3rem)}.proof-summary,.card-list li{border:2px solid #3f362a;border-radius:1rem;background:var(--panel)}.proof-summary{padding:1.1rem 1.2rem}.proof-summary h2,.card-list h2{margin:0 0 .55rem;font-size:1.3rem}.proof-summary ul{margin:.4rem 0 0;padding-left:1.2rem}.proof-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem;margin:1.5rem 0}.proof-grid figure{margin:0;overflow:hidden;border:2px solid #3f362a;border-radius:.8rem;background:var(--panel)}.proof-grid img{display:block;width:100%;aspect-ratio:1;object-fit:cover;background:#16110d}.proof-grid figcaption{padding:.35rem .55rem;color:var(--muted);font-size:.82rem}.source-note,.fine-print{color:var(--muted);font-size:.9rem}.card-list{display:grid;gap:1rem;padding:0;list-style:none}.card-list li{padding:1.25rem 1.35rem}.card-list p{margin:.35rem 0;color:var(--muted)}table{width:100%;margin:1.25rem 0;border-collapse:collapse}th,td{border:1px solid var(--line);padding:.7rem;text-align:left;vertical-align:top}th{background:#2b231b}code{border-radius:.3rem;background:#2b231b;padding:.13rem .3rem}pre{overflow:auto;border:2px solid #3f362a;border-radius:.8rem;background:#241d16;padding:1rem}
  .waitlist{display:grid;grid-template-columns:minmax(0,.9fr) minmax(18rem,1.1fr);gap:2rem;align-items:center;margin:4rem 0 0;padding:1.5rem;border:2px solid #3f362a;border-radius:1.15rem;background:linear-gradient(130deg,#2b231b,#1f1913);box-shadow:8px 8px 0 #120e0a}.waitlist h2{margin:.3rem 0;font-size:2rem}.waitlist p{margin:.5rem 0;color:var(--muted)}.waitlist form{min-width:0}.waitlist label{display:block;margin-bottom:.35rem;color:var(--muted);font-size:.9rem}.waitlist-row{display:flex;gap:.5rem}.waitlist input{min-width:0;flex:1;border:1px solid rgba(251,244,232,.22);border-radius:999px;background:rgba(251,244,232,.07);color:var(--text);padding:.72rem 1rem;font:inherit}.waitlist button{border:1px solid rgba(46,196,166,.55);border-radius:999px;background:linear-gradient(180deg,rgba(46,196,166,.4),rgba(46,196,166,.16));color:var(--mint-light);padding:.72rem 1.08rem;font:800 1rem var(--display);cursor:pointer}.waitlist button:hover{color:var(--text);background:linear-gradient(180deg,rgba(46,196,166,.55),rgba(46,196,166,.25))}
  @media (max-width:44rem){.site-header{align-items:flex-start;flex-direction:column;justify-content:center;padding-block:.9rem}nav{justify-content:flex-start}.waitlist{grid-template-columns:1fr}.site-footer{align-items:flex-start;flex-direction:column}}
  @media (max-width:36rem){.proof-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.waitlist-row{flex-direction:column}}
</style>
