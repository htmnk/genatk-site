---
interface Props {
  title: string;
  description: string;
  canonical?: string;
}
const { title, description, canonical = Astro.url.pathname } = Astro.props;
const canonicalUrl = Astro.site ? new URL(canonical, Astro.site) : undefined;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <title>{title}</title>
  </head>
  <body>
    <header>
      <a class="brand" href="/">GenATK</a>
      <nav aria-label="Primary"><a href="/learn/">Learn</a><a href="/guides/">Guides</a></nav>
    </header>
    <main><slot /></main>
    <footer><a href="/about/">About GenATK</a> · Generative Asset Toolkit.</footer>
  </body>
</html>

<style is:global>
  :root { color-scheme: dark; font-family: Inter, ui-sans-serif, system-ui, sans-serif; background: #121310; color: #edeee7; }
  body { margin: 0; line-height: 1.55; }
  header, main, footer { max-width: 68rem; margin: auto; padding: 1.25rem 1.5rem; }
  header { display: flex; justify-content: space-between; align-items: baseline; border-bottom: 1px solid #34372e; }
  .brand { color: #edeee7; font-weight: 700; text-decoration: none; }
  nav { display: flex; gap: 1rem; }
  a { color: #c7df9d; }
  article { max-width: 46rem; }
  h1 { font-size: clamp(2.25rem, 7vw, 4.5rem); line-height: 1.04; letter-spacing: -.04em; }
  h2 { margin-top: 2.75rem; }
  .eyebrow { color: #aeb39f; text-transform: uppercase; letter-spacing: .08em; font-size: .8rem; }
  .lede { color: #c9cbc3; font-size: 1.2rem; }
  .proof-summary { border: 1px solid #4d563f; background: #1a1d17; padding: 1.1rem 1.2rem; border-radius: .75rem; }
  .proof-summary h2 { margin: 0 0 .55rem; font-size: 1.1rem; }
  .proof-summary ul { margin: .4rem 0 0; padding-left: 1.2rem; }
  .proof-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: .75rem; margin: 1.5rem 0; }
  .proof-grid figure { margin: 0; border: 1px solid #34372e; border-radius: .55rem; overflow: hidden; background: #1a1d17; }
  .proof-grid img { display: block; width: 100%; aspect-ratio: 1; object-fit: cover; background: #20241c; }
  .proof-grid figcaption { padding: .35rem .55rem; color: #aeb39f; font-size: .82rem; }
  .source-note { color: #aeb39f; font-size: .92rem; }
  @media (max-width: 36rem) { .proof-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  footer { border-top: 1px solid #34372e; color: #aeb39f; margin-top: 4rem; font-size: .9rem; }
</style>
