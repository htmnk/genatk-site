---
import Base from '../layouts/Base.astro';
import Waitlist from '../components/Waitlist.astro';
---
<Base title="GenATK — Generative Asset Toolkit" description="Research, methods, and tools exploring deterministic, offline-ready generation for game assets.">
  <section class="home-hero">
    <div><p class="eyebrow">Generative Asset Toolkit</p><h1>Math that becomes places.</h1><p class="lede">GenATK is exploring deterministic, offline-minded generation for game assets—built around repeatable variation, practical review, and a smaller toolchain.</p><div class="actions"><a class="button" href="/labs/seeded-assets/">Explore the Wayfinder Lab <span aria-hidden="true">↗</span></a><a class="text-link" href="/research/">Our research standard</a></div></div>
    <div class="hero-object" aria-hidden="true"><div class="orbit orbit-one"></div><div class="orbit orbit-two"></div><div class="core"></div><div class="spire spire-one"></div><div class="spire spire-two"></div><div class="base base-one"></div><div class="base base-two"></div><span>GENATK / PUBLIC RESEARCH</span></div>
  </section>
  <section class="principles"><div><span>01</span><h2>Seeded by design</h2><p>Variation should be something a team can revisit, name, and review—not a one-time accident.</p></div><div><span>02</span><h2>Local by default</h2><p>We are investigating workflows that keep asset generation close to the project rather than dependent on a remote black box.</p></div><div><span>03</span><h2>Evidence before claims</h2><p>Public labs and notes describe their limits clearly. Product implementation remains private until it is ready.</p></div></section>
  <section class="home-feature"><div><p class="eyebrow">Public lab</p><h2>One seed. One landmark. A useful conversation.</h2><p>Use the 3D Wayfinder to inspect a seed-driven form, see a stable structural identity, and understand why reproducibility matters in an asset pipeline.</p><a href="/labs/seeded-assets/">Open the interactive lab →</a></div><div class="feature-card"><span>WAYFINDER / 01</span><strong>Original seeded<br />3D study</strong><p>Three.js · illustrative only</p></div></section>
  <section class="home-resources"><p class="eyebrow">Foundations</p><h2>Useful before the toolkit exists.</h2><div class="resource-grid"><a href="/learn/reproducible-procedural-assets/"><span>Learn</span><strong>Reproducible procedural assets are easier to review.</strong><em>Read note →</em></a><a href="/research/asset-review-record/"><span>Research</span><strong>A lightweight record for reviewing generated assets.</strong><em>Use worksheet →</em></a></div></section>
  <section class="home-waitlist"><Waitlist source="homepage" /></section>
</Base>

<style>
  .home-hero, .principles, .home-feature, .home-resources, .home-waitlist { width: min(100%, 76rem); margin: auto; padding-inline: clamp(1.15rem, 4vw, 2.5rem); }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1fr) minmax(22rem, .9fr); gap: 3rem; align-items: center; min-height: min(46rem, calc(100vh - 5.5rem)); padding-block: 5rem; } .home-hero h1 { font-size: clamp(3.6rem, 8.7vw, 7.4rem); } .actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-top: 2rem; } .button { display: inline-flex; align-items: center; gap: .55rem; } .text-link { color: #cbd5c5; }
  .hero-object { position: relative; aspect-ratio: 1; overflow: hidden; border: 1px solid #40503c; border-radius: 1.6rem; background: radial-gradient(circle at 50% 43%, #355630, #162116 42%, #0d110d 72%); box-shadow: inset 0 0 5rem #071007, 0 2rem 5rem #0007; } .hero-object span { position: absolute; left: 1rem; bottom: 1rem; color: #d8ead033; font-size: .7rem; letter-spacing: .13em; } .core { position: absolute; left: 50%; top: 41%; width: 17%; aspect-ratio: 1; transform: translate(-50%, -50%) rotate(45deg); background: #d6f79e; box-shadow: 0 0 3rem #d6f79e; } .spire { position: absolute; left: 50%; transform-origin: bottom; background: linear-gradient(#d6f79e, #58794f); clip-path: polygon(50% 0, 100% 100%, 0 100%); } .spire-one { width: 21%; height: 43%; top: 23%; transform: translateX(-50%); } .spire-two { width: 12%; height: 30%; top: 17%; transform: translateX(-50%) rotate(180deg); opacity: .6; } .base { position: absolute; left: 50%; border: 1px solid #90a987; background: #2d482b; transform: translateX(-50%); } .base-one { bottom: 19%; width: 55%; height: 14%; clip-path: polygon(10% 0, 90% 0, 100% 100%, 0 100%); } .base-two { bottom: 12%; width: 68%; height: 9%; clip-path: polygon(7% 0, 93% 0, 100% 100%, 0 100%); background: #172517; } .orbit { position: absolute; inset: 14%; border: 1px solid #d6f79e77; border-radius: 50%; transform: rotateX(64deg) rotateZ(26deg); } .orbit-two { inset: 25%; border-color: #d6f79e44; transform: rotateX(68deg) rotateZ(-30deg); }
  .principles { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; border: 1px solid #2d372c; border-radius: 1.2rem; overflow: hidden; background: #2d372c; } .principles div { padding: 1.6rem; background: #121612; } .principles span, .resource-grid span { color: #d6f79e; font-size: .78rem; font-weight: 750; letter-spacing: .1em; } .principles h2 { margin: .55rem 0; font-size: 1.35rem; } .principles p { color: #b9c3b5; margin: 0; }
  .home-feature { display: grid; grid-template-columns: 1.1fr .9fr; gap: 2rem; align-items: stretch; padding-block: 8rem; } .home-feature h2, .home-resources h2 { max-width: 16ch; margin: .4rem 0 1rem; font-size: clamp(2.2rem, 5vw, 4rem); } .home-feature p { max-width: 40rem; color: #c0c9bc; } .feature-card { display: flex; flex-direction: column; justify-content: space-between; min-height: 18rem; padding: 1.5rem; border: 1px solid #4d6248; border-radius: 1.2rem; background: radial-gradient(circle at 45% 33%, #3e6536, #182118 53%, #111411); } .feature-card span { color: #d5e6ce88; font-size: .72rem; letter-spacing: .12em; } .feature-card strong { font-size: clamp(1.8rem, 4vw, 3.1rem); line-height: 1; letter-spacing: -.06em; } .feature-card p { color: #b4c5ae; margin: 0; }
  .home-resources { padding-bottom: 2rem; } .resource-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1rem; } .resource-grid a { display: flex; flex-direction: column; min-height: 14rem; padding: 1.4rem; border: 1px solid #2d372c; border-radius: 1rem; background: #131813; color: #edf4e8; text-decoration: none; } .resource-grid strong { max-width: 15ch; margin: .8rem 0 auto; font-size: 1.5rem; line-height: 1.1; letter-spacing: -.04em; } .resource-grid em { color: #d6f79e; font-size: .9rem; font-style: normal; }
  @media (max-width: 52rem) { .home-hero, .home-feature { grid-template-columns: 1fr; } .home-hero { min-height: auto; padding-top: 3rem; } .hero-object { max-width: 34rem; width: 100%; margin: auto; } .principles { grid-template-columns: 1fr; } .home-feature { padding-block: 5rem; } } @media (max-width: 36rem) { .home-hero h1 { font-size: 3.55rem; } .resource-grid { grid-template-columns: 1fr; } }
</style>
