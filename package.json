{
  "name": "genatk-content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @genatk/site",
    "build": "npm run build -w @genatk/site && npm run seo:static-audit",
    "build:drafts": "INCLUDE_DRAFTS=true npm run build",
    "preview": "npm run preview -w @genatk/site",
    "test": "node --test tests/**/*.test.mjs",
    "check": "npm run content:preflight && npm run content:disclosure && npm run check -w @genatk/site",
    "content:preflight": "node tools/seo/preflight.mjs",
    "content:disclosure": "node tools/seo/disclosure-scan.mjs",
    "content:context": "node tools/seo/prepare-context.mjs",
    "content:review": "node tools/seo/topic-review.mjs",
    "content:draft": "node tools/seo/draft.mjs",
    "content:promote": "node tools/seo/promote-draft.mjs",
    "seo:research": "node tools/seo/research.mjs",
    "seo:topic-radar": "node tools/seo/topic-radar.mjs",
    "seo:research-director": "node tools/seo/research-director.mjs",
    "seo:research-synthesis": "node tools/seo/research-synthesis.mjs",
    "seo:gsc-sync": "node tools/seo/gsc-sync.mjs",
    "seo:analytics-sync": "node tools/seo/analytics-sync.mjs",
    "seo:static-audit": "node tools/seo/static-audit.mjs",
    "seo:lighthouse": "node tools/seo/lighthouse-audit.mjs",
    "seo:measure": "node tools/seo/measure.mjs",
    "seo:health": "node tools/seo/verify-live.mjs"
  },
  "devDependencies": {
    "lighthouse": "^13.4.1",
    "puppeteer": "^25.8.0"
  }
}
